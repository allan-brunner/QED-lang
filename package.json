{
  "name": "qed-lang",
  "version": "0.1.0",
  "description": "A math-first interpreted programming language",
  "type": "module",
  "bin": {
    "qed": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:cli": "esbuild src/cli/index.ts --bundle --format=esm --platform=node --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli.js",
    "build:web": "esbuild src/web/index.ts --bundle --format=esm --platform=browser --outfile=dist/qed.browser.js",
    "build": "npm run typecheck && npm run build:cli && npm run build:web"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}