{
  "name": "qed-lang",
  "version": "0.1.0",
  "description": "A math-first interpreted programming language",
  "type": "module",
  "bin": {
    "qed": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:cli": "esbuild src/cli/index.ts --bundle --format=esm --platform=node --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli.js",
    "build:ide": "tsc -p tsconfig.ide.json",
    "watch:ide": "tsc -p tsconfig.ide.json --watch",
    "build": "npm run typecheck && npm run build:cli && npm run build:ide"
  },
  "dependencies": {
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "vitest": "^5.1.2"
  }
}